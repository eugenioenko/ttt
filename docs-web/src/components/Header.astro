---
import Header from '@astrojs/starlight/components/Header.astro';
const active = Astro.url.pathname === '/demo/';
---

<div class="docs-header">
  <Header />
  <a class="demo-link" href="/demo/" aria-current={active ? 'page' : undefined}>Demo</a>
</div>

<style>
  .docs-header { display: flex; align-items: center; gap: 1rem; height: 100%; }
  .docs-header :global(.header) { flex: 1; min-width: 0; }
  .demo-link { padding: 0.4rem 0.8rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.4rem; color: var(--sl-color-white); text-decoration: none; font-weight: 600; }
  .demo-link:hover, .demo-link[aria-current] { background: var(--sl-color-accent-low); border-color: var(--sl-color-accent); }
</style>
