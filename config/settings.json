{
  "version": 1,
  "theme": "default-dark",
  "appearance": {
    "icons": "none",
    "scrollbarGlyphs": "blocks"
  },
  "editor": {
    "tabSize": 4,
    "insertSpaces": true,
    "wordWrap": false,
    "wordWrapColumn": 0,
    "diffMode": "split",
    "diffContext": "changes",
    "diffWordWrap": false,
    "diffHighContrast": false,
    "diffEmphasizeCollapsedRows": false,
    "diffSigns": false,
    "diffSignsColor": true,
    "diffGutterHighlight": true,
    "diffColorGutterNumbers": false,
    "diffScrollbarGitMarks": false,
    "lineNumbers": true,
    "selectionStyle": "background",
    "formatOnSave": false,
    "insertFinalNewline": true,
    "trimTrailingWhitespace": false,
    "focusOnOpen": false,
    "gutterStyle": "compact",
    "borderStyle": "default",
    "bracketPairColorization": false,
    "transparentBackground": false,
    "saveAllOnQuit": false,
    "saveAllOnQuitExceptUnnamed": false
  },
  "quickOpen": {
    "showHidden": false,
    "showGitIgnored": false
  },
  "search": {
    "debounce": 350
  },
  "explorer": {
    "showHidden": true,
    "showGitIgnored": true,
    "gitStatusColors": true,
    "dimStagedGitColors": false,
    "autoReveal": false
  },
  "git": {
    "fileView": "list"
  },
  "terminal": {
    "scrollback": 1000,
    "selectionStyle": "background",
    "ctrlVPastes": true
  },
  "lsp": {
    "saveOnRename": false,
    "hoverDelay": 500
  },
  "autocomplete": {
    "enabled": true,
    "autoSuggest": true,
    "debounce": 150,
    "signatureHelp": true
  },
  "markdown": {
    "wrapWidth": 80
  },
  "image": {
    "protocol": "auto"
  },
  "plugins": {
    "selectionStyle": "invert"
  }
}
