{
  "version": 1,
  "theme": "default-dark",
  "appearance": {
    "icons": "none",
    "scrollbarGlyphs": "blocks"
  },
  "editor": {
    "tabSize": 4,
    "insertSpaces": true,
    "wordWrap": false,
    "diffMode": "split",
    "diffContext": "changes",
    "diffWordWrap": false,
    "diffHighContrast": false,
    "diffEmphasizeCollapsedRows": false,
    "diffSigns": false,
    "diffSignsColor": true,
    "diffGutterHighlight": true,
    "diffColorGutterNumbers": false,
    "diffScrollbarGitMarks": false,
    "lineNumbers": true,
    "formatOnSave": false,
    "insertFinalNewline": true,
    "trimTrailingWhitespace": false,
    "focusOnOpen": false,
    "gutterStyle": "compact",
    "borderStyle": "default",
    "bracketPairColorization": false,
    "transparentBackground": false,
    "saveAllOnQuit": false,
    "saveAllOnQuitExceptUnnamed": false
  },
  "search": {
    "debounce": 350
  },
  "explorer": {
    "showHidden": true,
    "showGitIgnored": true,
    "gitStatusColors": true,
    "dimStagedGitColors": false,
    "autoReveal": false
  },
  "git": {
    "fileView": "list"
  },
  "terminal": {
    "scrollback": 1000
  },
  "agents": {
    "claude": {
      "cli": "claude",
      "args": "-p",
      "install": "npm install -g @anthropic-ai/claude-code"
    },
    "codebuddy": {
      "cli": "codebuddy",
      "install": "npm install -g @tencent-ai/codebuddy-code"
    },
    "codex": {
      "cli": "codex",
      "install": "npm install -g @openai/codex"
    },
    "copilot": {
      "cli": "gh",
      "args": "copilot",
      "install": "gh extension install github/gh-copilot"
    },
    "cursor": {
      "cli": "cursor-agent",
      "install": "curl https://cursor.com/install -fsS | bash"
    },
    "kimi": {
      "cli": "kimi",
      "install": "pip install kimi-cli"
    }
  },
  "lsp": {
    "saveOnRename": false,
    "hoverDelay": 500
  },
  "autocomplete": {
    "enabled": true,
    "autoSuggest": true,
    "debounce": 150,
    "signatureHelp": true
  },
  "markdown": {
    "wrapWidth": 80
  },
  "image": {
    "protocol": "auto"
  }
}
