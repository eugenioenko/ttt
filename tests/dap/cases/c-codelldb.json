{
  "name": "c-codelldb",
  "requires": ["install/codelldb.sh", "install/gdb.sh"],
  "source": "fixtures/c-counter/main.c",
  "binary": "bin/linux-amd64/c-counter",
  "settings": {
    "debug": {
      "adapters": {"lldb": {"command": ["codelldb", "--port", "${port}"], "transport": "server", "languages": ["c"]}}
    }
  },
  "launch": {"name": "c-codelldb", "type": "lldb", "request": "launch", "program": "${workspaceFolder}/c-counter"},
  "baseline": {
    "breakpoint": {"line": 7, "locals": {"count": "41"}},
    "afterOver": {"line": 8, "locals": {"count": "42"}},
    "insideCall": {"line": 3, "locals": {"value": "42"}},
    "afterOut": {"line": 8, "locals": {"count": "42"}},
    "output": "count = 43"
  },
  "pidAttach": {"arguments": {"pid": "${pid}"}, "picker": {"skip": "ttt process picker requires a provider hook"}},
  "lifecycle": {"program": "${workspaceFolder}/c-attach"},
  "service": {
    "source": "fixtures/c-attach/main.c",
    "binary": "bin/linux-amd64/c-attach",
    "command": ["./c-attach"],
    "line": 14,
    "nextLine": 15,
    "locals": {"value": "42"}
  },
  "addressAttach": {
    "command": ["gdbserver", "--once", "--attach", "127.0.0.1:0", "${pid}"],
    "portPattern": "Listening on port (\\d+)",
    "arguments": {
      "program": "${workspaceFolder}/c-attach",
      "targetCreateCommands": ["target create ${workspaceFolder}/c-attach"],
      "processCreateCommands": ["gdb-remote 127.0.0.1:${port}"]
    },
    "continueOnAttach": true
  }
}
