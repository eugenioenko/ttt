{
  "name": "c-gdb",
  "requires": [
    "install/gdb.sh"
  ],
  "source": "fixtures/c-counter/main.c",
  "binary": "bin/linux-amd64/c-counter",
  "settings": {
    "debug": {
      "adapters": {
        "gdb": {
          "command": [
            "gdb",
            "-q",
            "-nx",
            "-i",
            "dap"
          ],
          "languages": [
            "c"
          ]
        }
      }
    }
  },
  "launch": {
    "name": "c-gdb",
    "type": "gdb",
    "request": "launch",
    "program": "${workspaceFolder}/c-counter"
  },
  "breakpoint": {
    "line": 7
  },
  "inspection": [
    {
      "line": 7,
      "variable": "count = 41"
    },
    {
      "key": "f10",
      "line": 8,
      "variable": "count = 42"
    },
    {
      "key": "f11",
      "line": 3,
      "variable": "value = 42"
    },
    {
      "key": "shift+f11",
      "line": 8,
      "variable": "count = 42"
    }
  ]
}
