{
  "name": "python-debugpy",
  "requires": [
    "install/debugpy.sh"
  ],
  "source": "fixtures/python-counter/main.py",
  "settings": {
    "debug": {
      "adapters": {
        "debugpy": {
          "command": [
            "${python}",
            "-m",
            "debugpy.adapter"
          ],
          "provider": "debugpy",
          "languages": [
            "python"
          ]
        }
      }
    }
  },
  "launch": {
    "name": "python-debugpy",
    "type": "debugpy",
    "request": "launch",
    "program": "${workspaceFolder}/main.py",
    "python": "dap-python"
  },
  "pidAttach": {
    "arguments": {
      "processId": "${pid}",
      "python": "dap-python"
    }
  },
  "service": {
    "source": "fixtures/python-attach/example.py",
    "command": [
      "dap-python",
      "example.py"
    ],
    "line": 15,
    "nextLine": 16,
    "locals": {
      "value": "42"
    }
  },
  "addressAttach": {
    "command": [
      "dap-python",
      "example.py",
      "--listen"
    ],
    "portFile": "port",
    "arguments": {
      "connect": {
        "host": "127.0.0.1",
        "port": "${port}"
      }
    }
  },
  "breakpoint": {
    "line": 6
  },
  "inspection": [
    {
      "line": 6,
      "variable": "count = 41"
    },
    {
      "key": "f10",
      "line": 7,
      "variable": "count = 42"
    },
    {
      "key": "f11",
      "line": 2,
      "variable": "value = 42"
    },
    {
      "key": "shift+f11",
      "line": 7,
      "variable": "count = 42"
    }
  ],
  "lifecycle": {
    "program": "${workspaceFolder}/example.py",
    "python": "dap-python"
  }
}
